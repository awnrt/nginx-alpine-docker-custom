-
-cat > pkg/DEBIAN/control <<EOF
-Package: nginx-custom
-Version: ${nginx_version}-2
-Section: httpd
-Priority: optional
-Architecture: ${ARCH}
-Depends: libc6 (>= 2.34), lsb-base, libmaxminddb0
-Provides: httpd, nginx
-Conflicts: nginx, nginx-common, nginx-core, nginx-full, nginx-light, nginx-extras
-Replaces: nginx, nginx-common, nginx-core, nginx-full, nginx-light, nginx-extras
-Breaks: nginx-core (<< ${nginx_version}), nginx-extras (<< ${nginx_version}), nginx-light (<< ${nginx_version})
-Maintainer: ${maintainer}
