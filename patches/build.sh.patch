-cat > pkg/DEBIAN/postinst <<EOF
-#!/bin/sh
-set -e
-
-if ! getent group ${group} >/dev/null; then
-    addgroup --system ${group}
-fi
-if ! getent passwd ${user} >/dev/null; then
-    adduser --system --no-create-home --disabled-login --ingroup ${group} ${user}
